{
  "name": "tuinbooks-v2",
  "private": true,
  "version": "2.0.0-parity-r25",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/build-release-ui-restored.mjs",
    "dev": "python3 -m http.server 5173 -d dist",
    "test:domain": "rm -rf .domain-test && tsc -p tsconfig.domain.json && node tests/run-domain-tests.mjs",
    "check": "npm run test:domain && npm run test:stress && npm run test:release && npm run build && npm run test:xlsx && npm run test:static && npm run test:http",
    "test:stress": "rm -rf .domain-test && tsc -p tsconfig.domain.json && node tests/run-stress-tests.mjs",
    "test:static": "node tests/check-static.mjs",
    "test:xlsx": "node tests/run-xlsx-roundtrip.mjs",
    "test:http": "node tests/run-http-smoke.mjs",
    "test:release": "node tests/run-release-contract.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
